# ===========================================================================
# ConversIA — environment variables
# ---------------------------------------------------------------------------
# Copy to .env.local for local work (it is gitignored) and set the real values
# in Vercel: Project > Settings > Environment Variables.
#
# NEVER commit real values. Everything here is server-side only — none of it is
# bundled into the static site, because there is no build step that could leak it.
# ===========================================================================


# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Dashboard > Project Settings > Data API  /  API Keys
SUPABASE_URL=https://qzgfumucqldtwevkjhji.supabase.co

# SECRET. Bypasses Row Level Security. Server-side only — never ship to a browser.
SUPABASE_SERVICE_ROLE_KEY=


# ---------------------------------------------------------------------------
# 360dialog Partner API
# ---------------------------------------------------------------------------
# Partner Hub > Organization. Numeric/UUID partner identifier.
D360_PARTNER_ID=

# Login used to mint partner tokens (the account itself, not a client channel).
D360_PARTNER_USERNAME=
D360_PARTNER_PASSWORD=

# SECRET used to verify the HMAC signature on partner webhooks.
D360_PARTNER_WEBHOOK_SECRET=

# Header carrying that signature. Override if your account sends a different one.
D360_SIGNATURE_HEADER=x-360dialog-signature

# Set to "true" ONLY to capture the first partner webhook and discover the real
# header name and payload shape. Remove it as soon as signatures verify.
D360_ALLOW_UNSIGNED=false

# API bases. Defaults are correct for production; override only for sandboxes.
# D360_HUB_BASE=https://hub.360dialog.io/api/v2
# D360_WABA_BASE=https://waba-v2.360dialog.io


# ---------------------------------------------------------------------------
# Bridge secrets (generate with: openssl rand -hex 32)
# ---------------------------------------------------------------------------
# Appended as ?secret=... to the inbound webhook URL registered per number,
# so /api/inbound is not an open endpoint.
BRIDGE_INBOUND_SECRET=

# Sent by Make to /api/send as `x-bridge-secret` or `Authorization: Bearer ...`.
BRIDGE_SEND_SECRET=


# ---------------------------------------------------------------------------
# Make.com
# ---------------------------------------------------------------------------
# Custom webhook URL of the scenario that handles inbound messages.
MAKE_WEBHOOK_URL=https://hook.eu2.make.com/xxxxxxxxxxxxxxxxxxxxxxxx


# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# Public origin of THIS project, no trailing slash. Used to build the inbound
# webhook URL registered with 360dialog. Set it to the custom domain once live.
PUBLIC_BASE_URL=https://conversia-site.vercel.app


# ---------------------------------------------------------------------------
# Site WhatsApp number
# ---------------------------------------------------------------------------
# The number behind every "Falar no WhatsApp" button, international format,
# digits only (e.g. 5511987654321).
#
# NOTE: the marketing site is static with no build step, so it cannot read this
# variable at runtime. The value that actually ships is WHATSAPP_NUMBER at the
# top of script.js — edit it there. This entry exists so the number is recorded
# in one obvious place alongside the rest of the configuration.
SITE_WHATSAPP_NUMBER=
